{
  "name": "memoryclash",
  "private": true,
  "version": "1.0.0",
  "description": "Jogo de memória para 2 jogadores em simultâneo — web e Android.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "build:single": "node scripts/build-single.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@fontsource-variable/fredoka": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
